# Número em formato internacional, somente dígitos.
PAIRING_PHONE=5511999999999

# Donos separados por vírgula.
OWNER_NUMBERS=5511999999999

DATABASE_PATH=./data/togi.sqlite
AUTH_DIR=./data/auth
LOG_LEVEL=info

# IA Togi
# deepseek = usa DeepSeek.
# mistral = usa Mistral.
# gemini = usa Gemini.
TOGI_AI_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Gemini (opcional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# IA local (opcional)
TOGI_LOCAL_AI_URL=http://127.0.0.1:8080
TOGI_LOCAL_AI_MODEL=qwen2.5-1.5b-instruct-q4_k_m.gguf
TOGI_LOCAL_AI_COMMAND=
TOGI_LOCAL_AI_TIMEOUT_MS=120000
TOGI_LOCAL_MAX_TOKENS=350

# Proteções da conversa
TOGI_AI_COOLDOWN_MS=3000
TOGI_AI_HISTORY_MESSAGES=10

# Música — Jamendo
# Crie uma aplicação no portal de desenvolvedores do Jamendo e coloque o client_id aqui.
JAMENDO_CLIENT_ID=
# Limite máximo do áudio recebido pelo Togi (padrão: 20 MB).
MUSIC_MAX_BYTES=20971520
