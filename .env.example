# Número em formato internacional, somente dígitos.
PAIRING_PHONE=5511999999999

# Donos separados por vírgula.
OWNER_NUMBERS=5511999999999

DATABASE_PATH=./data/togi.sqlite
AUTH_DIR=./data/auth
LOG_LEVEL=info

# IA Togi
# gemini = usa Gemini.
# auto = tenta IA local primeiro e usa Gemini somente se uma chave existir.
# local = IA rodando no próprio aparelho.
TOGI_AI_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# IA local (opcional; não é necessária para o Togi funcionar com Gemini)
TOGI_LOCAL_AI_URL=http://127.0.0.1:8080
TOGI_LOCAL_AI_MODEL=qwen2.5-1.5b-instruct-q4_k_m.gguf
TOGI_LOCAL_AI_COMMAND=
TOGI_LOCAL_AI_TIMEOUT_MS=120000
TOGI_LOCAL_MAX_TOKENS=350

# Proteções da conversa
TOGI_AI_COOLDOWN_MS=3000
TOGI_AI_HISTORY_MESSAGES=10
