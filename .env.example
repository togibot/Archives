# Número em formato internacional, somente dígitos.
PAIRING_PHONE=5511999999999

# Donos separados por vírgula.
OWNER_NUMBERS=5511999999999

DATABASE_PATH=./data/togi.sqlite
AUTH_DIR=./data/auth
LOG_LEVEL=info

# Supabase — persistência durável do Togi.
# Use a URL do projeto e uma SECRET KEY somente no servidor (.env).
SUPABASE_URL=https://fauqjljshvabhpbsbrey.supabase.co
SUPABASE_SECRET_KEY=

# IA Togi
# deepseek = usa DeepSeek.
# mistral = usa Mistral.
# gemini = usa Gemini.
TOGI_AI_PROVIDER=mistral

# Modo rápido da Togi AI
# Menos tokens e timeout menor deixam respostas mais rápidas.
TOGI_AI_MAX_TOKENS=240
TOGI_AI_TEMPERATURE=0.75
TOGI_AI_COOLDOWN_MS=1000
TOGI_AI_HISTORY_MESSAGES=8

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1
MISTRAL_TIMEOUT_MS=12000

# Gemini (opcional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# IA local (opcional)
TOGI_LOCAL_AI_URL=http://127.0.0.1:8080
TOGI_LOCAL_AI_MODEL=qwen2.5-1.5b-instruct-q4_k_m.gguf
TOGI_LOCAL_AI_COMMAND=
TOGI_LOCAL_AI_TIMEOUT_MS=120000
TOGI_LOCAL_MAX_TOKENS=350

# Música — Jamendo
JAMENDO_CLIENT_ID=
MUSIC_MAX_BYTES=20971520

# YouTube Data API v3 — usada somente para melhorar a identificação/busca da música.
YOUTUBE_API_KEY=
