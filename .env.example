# Número em formato internacional, somente dígitos.
PAIRING_PHONE=5511999999999

# Donos separados por vírgula.
OWNER_NUMBERS=5511999999999

DATABASE_PATH=./data/togi.sqlite
AUTH_DIR=./data/auth
LOG_LEVEL=info

# Supabase — persistência durável do Togi.
SUPABASE_URL=https://fauqjljshvabhpbsbrey.supabase.co
SUPABASE_SECRET_KEY=

# IA Togi — configuração simples do Mistral.
# O sistema usa somente estas duas variáveis para o Mistral.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# DeepSeek/Gemini podem permanecer no servidor para outros recursos futuros,
# mas não são necessários para a Togi AI atual.

# Música — Jamendo
JAMENDO_CLIENT_ID=
MUSIC_MAX_BYTES=20971520

# YouTube Data API v3 — usada somente para melhorar a identificação/busca da música.
YOUTUBE_API_KEY=

# ==========================================================
# 🎮 TOGI GAMES — configuração global
# ==========================================================
TOGI_GAMES_NAME=Togi Games

# Informe somente uma URL-base HTTPS. O Togi acrescenta automaticamente
# /doom/, /quake/, /wolf3d/, /hexen/, /supertuxkart/ ou /openttd/.
# Exemplo: https://games.seudominio.com (troque pelo seu domínio real).
# Deixe vazio até o endereço HTTPS global estar pronto.
TOGI_GAMES_URL=
